// tsconfig.json - editor type-checking only (the server runs as plain JavaScript with Node)
{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "strict": true,
        "noEmit": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2022"
    },
    "include": ["src/**/*.js"]
}
